# /etc/albam/albam.env 로 복사해서 값을 채운다.
#
#   sudo mkdir -p /etc/albam
#   sudo cp deploy/systemd/albam.env.example /etc/albam/albam.env
#   sudo chmod 600 /etc/albam/albam.env
#   sudo chown albam:albam /etc/albam/albam.env
#
# 이 파일(.example)에는 절대 실제 값을 적지 않는다 — git에 올라간다.
# 값에 따옴표를 쓰지 않는다. systemd는 따옴표까지 값으로 읽는다.

# --- DB (RDS) ---
# 접속 URL의 기본 DB는 공용 인프라용 tw_shared다. 서비스 테이블은 각자 tw_* 스키마에 있고, 없으면 Flyway가 만든다.
#   예: jdbc:mysql://<rds-host>:3306/tw_shared?createDatabaseIfNotExist=true&serverTimezone=Asia/Seoul
# DB 사용자에게 스키마 생성 권한이 필요하다.
# 비밀번호 변수는 DB_PASSWORD다. 기존 이름(MYSQL_PASSWORD)도 받는다.
DB_URL=jdbc:mysql://albam-prod-mysql.xxxxx.ap-northeast-2.rds.amazonaws.com:3306/tw_shared?createDatabaseIfNotExist=true&serverTimezone=Asia/Seoul
DB_USERNAME=admin
DB_PASSWORD=

# --- 인증 ---
# 32자 이상. 생성: openssl rand -base64 48
JWT_SECRET=
# HTTPS 배포에서는 반드시 true. false면 리프레시 토큰 쿠키가 평문으로도 오간다.
COOKIE_SECURE=true

# --- 도메인 ---
# API 주소. 메일의 이메일 인증 링크가 이곳을 거쳐 아래 프론트 주소로 넘어간다.
APP_BASE_URL=https://api.example.com
# 사용자가 브라우저로 여는 화면 주소. 비밀번호 재설정 링크가 여기를 가리키고,
# 이메일 인증도 처리 후 이곳의 로그인 화면으로 돌아온다.
# 비워두면 기본값이 http://localhost:5173 이라, 기동은 되지만 메일 링크가 전부 죽는다.
# 끝에 슬래시를 붙이지 말 것.
APP_FRONTEND_URL=https://albam.example.com
# 프론트 오리진. 쿠키 인증 때문에 와일드카드를 쓸 수 없어 명시해야 한다. 콤마로 여러 개.
CORS_ALLOWED_ORIGINS=https://albam.example.com

# --- S3 (파일) ---
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET_NAME=

# --- 벡터 DB (근로기준법 Q&A 임베딩, pgvector) ---
# 메인 DB(MySQL)와 엔진이 달라 같은 RDS 인스턴스에 얹을 수 없다. 트래픽이 없는 현 단계에서는
# 인스턴스를 하나 더 두는 대신 EC2 안에 직접 설치해서 쓴다. 규모가 커지면 RDS로 옮기고
# 아래 URL의 호스트만 바꾸면 된다.
#
# 설치 후 한 번은 확장을 켜야 한다: CREATE EXTENSION IF NOT EXISTS vector;
# 켜지 않으면 앱은 뜨지만 근로기준법 Q&A만 실패한다.
VECTOR_DB_URL=jdbc:postgresql://localhost:5432/albam_vector
VECTOR_DB_USERNAME=albam_app
VECTOR_DB_PASSWORD=

# --- OpenAI ---
# 대시보드에서 월 예산 상한도 함께 걸어둘 것.
OPENAI_API_KEY=

# --- 메일 (Gmail SMTP) ---
# 미설정이어도 앱은 뜨고, 메일 발송 시점에만 실패한다.
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=

# --- 운영 ---
# 지식베이스 적재 API 호출용 토큰. 비워두면 그 API 자체가 닫힌다(안전한 기본값).
# 생성: openssl rand -hex 32
ADMIN_INGEST_TOKEN=
# 로그 파일 경로. systemd 유닛이 이 디렉토리에만 쓰기를 허용한다.
LOG_FILE=/var/log/albam/albam.log
