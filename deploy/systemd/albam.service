# ToTheWork 백엔드 systemd 서비스 (EC2 배포용)
# 서비스 이름·계정·경로(albam)는 기존 서버 설정을 그대로 쓰려고 옛 이름을 유지한다.
#
# 설치
#   sudo cp deploy/systemd/albam.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable albam        # 부팅 시 자동 시작
#   sudo systemctl start albam
#
# 확인
#   sudo systemctl status albam
#   sudo journalctl -u albam -f        # 실시간 로그 (파일 로그와 별개로 stdout도 여기 쌓인다)
#
# 배포 (jar 교체 후)
#   sudo systemctl restart albam
#
# 사전 준비
#   sudo useradd -r -s /bin/false albam            # 로그인 불가 전용 계정
#   sudo mkdir -p /opt/albam /var/log/albam
#   sudo chown -R albam:albam /opt/albam /var/log/albam
#   # jar(app/build/libs/app-0.0.1-SNAPSHOT.jar)를 /opt/albam/albam.jar 로 배치
#   # 환경변수 파일을 /etc/albam/albam.env 로 배치 (아래 참고)

[Unit]
Description=ToTheWork backend
# 네트워크가 준비된 뒤에 뜨도록 한다. RDS·S3·OpenAI 모두 네트워크가 필요하다.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# root로 돌리지 않는다. 앱이 뚫려도 서버 전체를 잃지 않게 하는 가장 기본적인 방어선이다.
User=albam
Group=albam

WorkingDirectory=/opt/albam

# 시크릿(DB 비밀번호, JWT_SECRET, OPENAI_API_KEY 등)은 이 파일에 KEY=VALUE 형식으로 둔다.
# 반드시 권한을 좁힐 것:
#   sudo chmod 600 /etc/albam/albam.env
#   sudo chown albam:albam /etc/albam/albam.env
# 이 파일은 절대 git에 넣지 않는다.
EnvironmentFile=/etc/albam/albam.env

# -XX:MaxRAMPercentage: 컨테이너·소형 인스턴스에서 힙을 물리 메모리 비율로 잡는다.
# 고정값(-Xmx)보다 인스턴스 타입을 바꿔도 그대로 쓸 수 있어 편하다.
# t3.micro(1GB)면 75%도 빠듯하므로 스왑을 함께 잡아둘 것.
ExecStart=/usr/bin/java -XX:MaxRAMPercentage=75 -jar /opt/albam/albam.jar

# 비정상 종료 시에만 재시작한다. systemctl stop 같은 의도적 종료는 그대로 둔다.
Restart=on-failure
RestartSec=10

# 재시작 폭주 방지: 5분 안에 5번 실패하면 멈추고 사람을 기다린다.
# 설정 오류로 부팅이 계속 실패할 때 무한 재시작으로 로그가 넘치는 것을 막는다.
StartLimitIntervalSec=300
StartLimitBurst=5

# 종료 시 유예 시간. 처리 중이던 요청이 끝날 여유를 준다.
TimeoutStopSec=30

# --- 최소한의 격리 ---
# 앱이 침해당했을 때 건드릴 수 있는 범위를 줄인다.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
# 로그 디렉토리는 써야 하므로 예외로 연다.
ReadWritePaths=/var/log/albam

[Install]
WantedBy=multi-user.target
